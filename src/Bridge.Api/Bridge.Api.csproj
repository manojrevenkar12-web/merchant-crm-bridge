<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The bridge's API (REST + GraphQL) for operations and the CRM, secured with Microsoft Entra ID, and
       the host that runs the consumers, the outbox relay and the reconciler when they are not running
       in Azure Functions. With demo mode it brings its own Dataverse emulator and platform simulator. -->
  <PropertyGroup>
    <RootNamespace>Bridge.Api</RootNamespace>
    <UserSecretsId>merchant-crm-bridge</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bridge.Core\Bridge.Core.csproj" />
    <ProjectReference Include="..\Bridge.Dataverse\Bridge.Dataverse.csproj" />
    <ProjectReference Include="..\Bridge.Kafka\Bridge.Kafka.csproj" />
    <ProjectReference Include="..\Bridge.Platform\Bridge.Platform.csproj" />
    <ProjectReference Include="..\Bridge.Emulator\Bridge.Emulator.csproj" />
    <ProjectReference Include="..\Bridge.PlatformSim\Bridge.PlatformSim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\contracts\openapi.json" Link="openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
