<Project Sdk="Microsoft.NET.Sdk">
  <!-- The API in-process (WebApplicationFactory) in demo mode: OpenAPI contract both ways, response
       schemas, Entra-style app roles, dead-letter replay and GraphQL. -->
  <PropertyGroup>
    <!-- Calls go to an in-process server; the fixture bounds every wait itself. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bridge.Api\Bridge.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\contracts\openapi.json" Link="openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
