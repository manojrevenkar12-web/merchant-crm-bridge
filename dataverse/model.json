          "uniqueName": "EventId",
          "type": "string"
        }
      ]
    }
  ],
  "pluginSteps": [
    {
      "plugin": "MerchantCrmBridge.Plugins.ValidateMerchantPlugin",
      "message": "Create",
      "entity": "account",
      "stage": "PreValidation",
      "mode": "Synchronous",
      "rank": 1
    },
    {
      "plugin": "MerchantCrmBridge.Plugins.ValidateMerchantPlugin",
      "message": "Update",
      "entity": "account",
      "stage": "PreValidation",
      "mode": "Synchronous",
      "rank": 1,
      "filteringAttributes": [
        "mcb_iban",
        "mcb_mcc",
        "mcb_country",
        "mcb_merchantid"
      ]
    },
    {
      "plugin": "MerchantCrmBridge.Plugins.MerchantOutboxPlugin",
      "message": "Update",
      "entity": "account",
      "stage": "PreOperation",
      "mode": "Synchronous",
      "rank": 10,
      "filteringAttributes": [
        "name",
        "emailaddress1",
        "mcb_legalform",
        "mcb_country",
        "mcb_iban",
        "mcb_mcc",
        "mcb_pricingplan"
      ],
      "preImage": [
        "mcb_merchantid",
        "mcb_lifecyclestage",
        "mcb_crmversion",
        "name",
        "emailaddress1",
        "mcb_legalform",
        "mcb_country",
        "mcb_iban",
        "mcb_mcc",
        "mcb_pricingplan"
      ]
    }
  ],
