        "mcb_driftfinding": [
          "Create",
          "Read",
          "Write"
        ],
        "mcb_bridgelease": [
          "Create",
          "Read",
          "Write"
        ]
      }
    },
    {
      "name": "Merchant Bridge Sales",
      "description": "Sales and onboarding: merchants, their terminals and the sync status.",
      "privileges": {
        "mcb_terminal": [
          "Read"
        ],
        "mcb_driftfinding": [
          "Read"
        ],
        "mcb_outboxmessage": [
          "Read"
        ],
        "mcb_inboundevent": [
          "Read"
        ]
      }
    }
  ],
  "fieldSecurityProfiles": [
    {
      "name": "Merchant Bridge Integration",
      "description": "Platform-owned columns: written only by the bridge.",
      "owners": [
        "platform"
      ],
      "read": true,
      "update": true,
      "create": true
    },
    {
      "name": "Merchant Bridge Readers",
      "description": "Everyone who works with merchants reads the platform-owned columns.",
      "owners": [
        "platform"
      ],
      "read": true,
      "update": false,
      "create": false
    }
  ],
  "app": {
    "uniqueName": "mcb_MerchantOnboarding",
    "displayName": "Merchant Onboarding",
    "description": "Sales and onboarding: merchants from prospect to live, with the platform's view beside the CRM's.",
    "areas": [
      {
        "title": "Merchants",
        "groups": [
          {
            "title": "Merchants",
            "tables": [
              "account",
              "mcb_terminal"
            ]
          }
        ]
      },
      {
        "title": "Sync",
        "groups": [
          {
            "title": "Bridge",
            "tables": [
              "mcb_driftfinding",
              "mcb_outboxmessage",
              "mcb_inboundevent"
            ]
          }
        ]
      }
    ]
  },
  "flows": [
