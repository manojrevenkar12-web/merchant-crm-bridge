  "securityRoles": [
    {
      "name": "Merchant Bridge Integration",
      "description": "The bridge's application user: writes platform-owned columns and its own tables.",
      "privileges": {
        "account": [
          "Read",
          "Write"
        ],
        "mcb_terminal": [
          "Create",
          "Read",
          "Write"
        ],
        "mcb_outboxmessage": [
          "Read",
          "Write"
