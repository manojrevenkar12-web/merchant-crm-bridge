{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example/merchant-crm-bridge/crm.merchant.onboarding_requested.v1.json",
  "title": "crm.merchant.onboarding_requested v1",
  "description": "Sales handed a merchant to the platform for onboarding. Emitted from the Dataverse outbox.",
  "type": "object",
  "properties": {
    "merchantId": {
      "type": "string",
      "pattern": "^M-[0-9]{6}$"
    },
    "legalName": {
      "type": "string",
      "minLength": 1
    },
    "contactEmail": {
      "type": "string"
    },
    "legalForm": {
      "enum": [
        "gmbh",
        "ug",
        "ag",
        "ek",
        "gbr",
        "sole_trader",
        "other"
      ]
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "iban": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$"
    },
    "mcc": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "pricingPlan": {
      "enum": [
        "starter",
        "growth",
        "enterprise"
      ]
    }
  },
  "required": [
    "merchantId",
    "legalName",
    "contactEmail",
    "legalForm",
    "country",
    "iban",
    "mcc",
    "pricingPlan"
  ],
  "additionalProperties": true
}