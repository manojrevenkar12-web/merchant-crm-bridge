{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example/merchant-crm-bridge/platform.merchant.volume_reported.v1.json",
  "title": "platform.merchant.volume_reported v1",
  "description": "Monthly processed volume in euro cents (superseded by v2).",
  "type": "object",
  "properties": {
    "merchantId": {
      "type": "string",
      "pattern": "^M-[0-9]{6}$"
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "volumeCents": {
      "type": "integer",
      "minimum": 0
    },
    "transactions": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "merchantId",
    "month",
    "volumeCents",
    "transactions"
  ],
  "additionalProperties": true
}